# Canonical key. ANTHROPIC_API_KEY remains a compatibility alias.
DEEPSEEK_API_KEY=

# OpenAI API (for embeddings)
OPENAI_API_KEY=sk-your-key-here

# Optional: Semantic Scholar API Key (free tier available without key, but key gives higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Optional: PubMed / NCBI API Key (for higher rate limits)
PUBMED_API_KEY=
PUBMED_EMAIL=your-email@example.com

# Optional: Crossref Plus API Token (polite pool works without it)
CROSSREF_EMAIL=your-email@example.com

# Application Settings
ENVIRONMENT=development
RESEARCH_RUNNER_MODE=real
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Model Configuration
DEFAULT_MODEL=deepseek-flash
LIGHT_MODEL=deepseek-flash
EMBEDDING_MODEL=text-embedding-v4

# Database
DATABASE_URL=sqlite:///data/research.db
DATABASE_PATH=data/research.db
CHROMA_PERSIST_DIR=data/chroma_db
PAPER_CACHE_DIR=data/paper_cache
FIGURES_DIR=data/figures

# Research limits
MAX_SEARCH_ROUNDS=2
SEARCH_RESULTS_PER_SOURCE=6
MAX_CANDIDATE_PAPERS=40
MAX_CRITIQUE_ROUNDS=1
WRITER_MAX_TOKENS=16000
WRITER_MIN_CHARACTERS=3000
WRITER_CONTINUATION_TOKENS=3000
READ_CONCURRENCY=5
CHUNK_SIZE=512
CHUNK_OVERLAP=128
RETRIEVAL_TOP_K=6

# Frontend
BACKEND_URL=http://localhost:8000
# Public browser config belongs in web/.env.local when overriding the default.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Ali Bailian for embedding (DashScope)
DASHSCOPE_API_KEY=

# Unpaywall (for PDF download)
UNPAYWALL_EMAIL=your-email@example.com
UNPAYWALL_PROXY=

# Bounded reading (seconds; retries are included)
READ_STAGE_TIMEOUT=600
READ_PAPER_TIMEOUT=180
DOWNLOAD_TIMEOUT=60
DOWNLOAD_CONNECT_TIMEOUT=10
DOWNLOAD_IDLE_TIMEOUT=15
PDF_PARSE_TIMEOUT=30
PDF_PARSE_CONCURRENCY=2
READ_SUMMARY_TIMEOUT=60
MODEL_REQUEST_TIMEOUT=120
EMBEDDING_TIMEOUT=20
VECTOR_TIMEOUT=15
