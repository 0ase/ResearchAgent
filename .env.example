# DeepSeek API (used by the research agents)
DEEPSEEK_API_KEY=sk-your-key-here

# OpenAI API (for embeddings)
OPENAI_API_KEY=sk-your-key-here

# Optional: Semantic Scholar API Key (free tier available without key, but key gives higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Optional: PubMed / NCBI API Key (for higher rate limits)
PUBMED_API_KEY=
PUBMED_EMAIL=your-email@example.com

# Optional: Crossref Plus API Token (polite pool works without it)
CROSSREF_EMAIL=your-email@example.com

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
RESEARCH_RUNNER_MODE=real
DEMO_DELAY_SECONDS=0

# Web application
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_PATH=data/research.db
EVENT_KEEPALIVE_SECONDS=15

# Model Configuration
DEFAULT_MODEL=deepseek-v4-flash
LIGHT_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=text-embedding-3-large

# Database
DATABASE_URL=sqlite:///data/research.db
CHROMA_PERSIST_DIR=data/chroma_db
PAPER_CACHE_DIR=data/paper_cache
FIGURES_DIR=data/figures

# Ali Bailian for embedding (DashScope)
DASHSCOPE_API_KEY=sk-your-key-here

# Unpaywall (for PDF download)
UNPAYWALL_EMAIL=your-email@example.com
UNPAYWALL_PROXY=

# Next.js frontend (copy to web/.env.local when overriding the default)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
