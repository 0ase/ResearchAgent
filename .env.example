# OpenAI-compatible LLM API key: configure either key accepted by BASE_URL.
# OPENAI_API_KEY takes precedence when both are non-empty.
OPENAI_API_KEY=

# Alternative key name retained for compatibility with existing configuration.
ANTHROPIC_API_KEY=

# Optional: Semantic Scholar API Key (free tier available without key, but key gives higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Optional: PubMed / NCBI API Key (for higher rate limits)
PUBMED_API_KEY=
PUBMED_EMAIL=your-email@example.com

# Optional: Crossref Plus API Token (polite pool works without it)
CROSSREF_EMAIL=your-email@example.com

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Model Configuration
DEFAULT_MODEL=deepseek-v4-pro
LIGHT_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-v4

# Database
DATABASE_URL=sqlite:///data/research.db
CHROMA_PERSIST_DIR=data/chroma_db
PAPER_CACHE_DIR=data/paper_cache
FIGURES_DIR=data/figures

# Research limits
MAX_SEARCH_ROUNDS=5
SEARCH_RESULTS_PER_SOURCE=20
MIN_CANDIDATE_PAPERS=80
MAX_CANDIDATE_PAPERS=100
SCREENING_MIN_SCORE=70
SCREENING_SUPPLEMENT_MIN_SCORE=65
SCREENING_BATCH_SIZE=5
SCREENING_MAX_TOKENS=6000
# Optional JSON containing verified venue metrics, with source and metric year.
VENUE_QUALITY_PATH=
ANALYSIS_MAX_TOKENS=6000
ANALYSIS_RETRY_MAX_TOKENS=8000
ANALYSIS_MAX_ATTEMPTS=2
ANALYSIS_THINKING_EFFORT=low
MAX_CRITIQUE_ROUNDS=2
WRITER_MAX_TOKENS=8000
WRITER_MIN_CHARACTERS=5000
WRITER_CONTINUATION_TOKENS=3000
READ_CONCURRENCY=5
CHUNK_SIZE=512
CHUNK_OVERLAP=128
RETRIEVAL_TOP_K=6

# Frontend
BACKEND_URL=http://127.0.0.1:3000

# Ali Bailian for embedding (DashScope)
DASHSCOPE_API_KEY=sk-your-key-here

# Unpaywall (for PDF download)
UNPAYWALL_EMAIL=your-email@example.com
UNPAYWALL_PROXY=
